{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(date:*)",
      "Read",
      "Edit",
      "Write",
      "Task",
      "TaskOutput"
    ],
    "deny": []
  },
  "env": {
    "HANDOFF_DIR": ".handoff"
  },
  "autoCompact": true,
  "thinking": true,
  "thinkingBudget": 10000
}
