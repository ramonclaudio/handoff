#!/bin/bash

# Handoff CLI - Wrapper for claude with handoff workflow
#
# Usage:
#   handoff                    # Start claude with handoff context
#   handoff --resume [name]    # Resume session with handoff
#   handoff --start            # Just run handoff start (no claude)
#   handoff --end              # Just run handoff end (no claude)
#   handoff --init             # Initialize handoff in current project
#   handoff --status           # Show handoff status

set -e

HANDOFF_DIR="${HANDOFF_DIR:-.handoff}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

show_help() {
    cat << EOF
Handoff CLI - Session continuity for AI-assisted coding

Usage:
    handoff [options] [claude-args...]

Options:
    --help, -h          Show this help
    --init              Initialize handoff in current project
    --start             Run handoff start workflow (gather context)
    --end               Run handoff end workflow (archive + update)
    --status            Show current handoff status
    --resume [name]     Resume named session with handoff context
    --dir <path>        Use custom handoff directory (default: .handoff)

Examples:
    handoff                         # Start claude, runs /handoff start
    handoff --resume my-feature     # Resume session, runs /handoff start
    handoff --init                  # Initialize handoff in project
    handoff --end                   # Archive and update handoff
    handoff --status                # Quick status check
    handoff "continue the auth PR"  # Start with prompt + handoff

Environment:
    HANDOFF_DIR     Custom handoff directory (default: .handoff)

EOF
}

init_handoff() {
    echo -e "${BLUE}Initializing handoff...${NC}"

    mkdir -p "$HANDOFF_DIR/sessions"
    echo -e "${GREEN}✓${NC} Created $HANDOFF_DIR/"
    echo -e "${GREEN}✓${NC} Created $HANDOFF_DIR/sessions/"

    # Create minimal CONTEXT.md if not exists
    if [ ! -f "$HANDOFF_DIR/CONTEXT.md" ]; then
        cat > "$HANDOFF_DIR/CONTEXT.md" << 'CONTEXT_EOF'
# Project Name

> One-line description

## Links

| Resource | URL |
|----------|-----|
| Repository | |
| Issues | |

## Stack

| Layer | Package | Version |
|-------|---------|---------|
| | | |

## Commands

```bash
npm run dev
npm run build
npm run test
```

## What Never Works

| Problem | Solution |
|---------|----------|
| | |
CONTEXT_EOF
        echo -e "${GREEN}✓${NC} Created $HANDOFF_DIR/CONTEXT.md"
    fi

    # Create minimal HANDOFF.md if not exists
    if [ ! -f "$HANDOFF_DIR/HANDOFF.md" ]; then
        cat > "$HANDOFF_DIR/HANDOFF.md" << HANDOFF_EOF
# Handoff: $(basename "$(pwd)")

> Session: $(date +%Y-%m-%d)
> Task: Initial setup

## Status: IDLE

## Git State

- **Branch:** $(git branch --show-current 2>/dev/null || echo "N/A")
- **Status:** $(git status --short 2>/dev/null | wc -l | tr -d ' ') changes

## Done (This Session)

- [x] Initialized handoff

## Resume

**Next:** Fill in CONTEXT.md with project details
**Files to read:** $HANDOFF_DIR/CONTEXT.md
HANDOFF_EOF
        echo -e "${GREEN}✓${NC} Created $HANDOFF_DIR/HANDOFF.md"
    fi

    # Add to .gitignore
    if [ -f ".gitignore" ]; then
        if ! grep -q "\.handoff/sessions/" .gitignore 2>/dev/null; then
            echo "" >> .gitignore
            echo "# Handoff session archives" >> .gitignore
            echo ".handoff/sessions/" >> .gitignore
            echo -e "${GREEN}✓${NC} Added sessions/ to .gitignore"
        fi
    fi

    echo ""
    echo -e "${GREEN}Handoff initialized!${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Edit $HANDOFF_DIR/CONTEXT.md with project details"
    echo "  2. Run 'handoff' to start a session with context"
}

show_status() {
    echo -e "${BLUE}=== Handoff Status ===${NC}"
    echo ""

    if [ ! -d "$HANDOFF_DIR" ]; then
        echo -e "${YELLOW}No handoff directory found.${NC}"
        echo "Run 'handoff --init' to initialize."
        exit 0
    fi

    # Git status
    echo -e "${BLUE}Git:${NC}"
    echo "  Branch: $(git branch --show-current 2>/dev/null || echo 'N/A')"
    echo "  Status: $(git status --short 2>/dev/null | wc -l | tr -d ' ') uncommitted changes"
    echo ""

    # Open PRs
    if command -v gh &> /dev/null; then
        echo -e "${BLUE}Open PRs:${NC}"
        gh pr list --state=open --json number,title --jq '.[] | "  #\(.number) \(.title)"' 2>/dev/null || echo "  None"
        echo ""
    fi

    # Resume point
    if [ -f "$HANDOFF_DIR/HANDOFF.md" ]; then
        echo -e "${BLUE}Resume Point:${NC}"
        if grep -q "## Resume" "$HANDOFF_DIR/HANDOFF.md"; then
            sed -n '/## Resume/,/^##/p' "$HANDOFF_DIR/HANDOFF.md" | grep -E "^\*\*" | head -3 | sed 's/^/  /'
        else
            echo "  No resume point found"
        fi
        echo ""

        # Session count
        SESSION_COUNT=$(ls -1 "$HANDOFF_DIR/sessions/" 2>/dev/null | wc -l | tr -d ' ')
        echo -e "${BLUE}Sessions:${NC} $SESSION_COUNT archived"
    fi
}

run_handoff_start() {
    echo -e "${BLUE}=== Handoff Start ===${NC}"
    echo ""

    if [ ! -f "$HANDOFF_DIR/HANDOFF.md" ]; then
        echo -e "${YELLOW}No handoff found. Run 'handoff --init' first.${NC}"
        exit 1
    fi

    echo -e "${BLUE}Git State:${NC}"
    git branch --show-current
    git status --short
    echo ""

    echo -e "${BLUE}Recent Commits:${NC}"
    git log -5 --format='%h %s' 2>/dev/null || echo "No commits"
    echo ""

    if command -v gh &> /dev/null; then
        echo -e "${BLUE}Open PRs:${NC}"
        gh pr list --state=open --json number,title --jq '.[] | "#\(.number) \(.title)"' 2>/dev/null || echo "None"
        echo ""
    fi

    echo -e "${BLUE}Resume Point:${NC}"
    if grep -q "## Resume" "$HANDOFF_DIR/HANDOFF.md"; then
        sed -n '/## Resume/,/^##/p' "$HANDOFF_DIR/HANDOFF.md" | head -10
    fi
    echo ""

    echo -e "${GREEN}Context gathered. Ready to continue.${NC}"
}

run_handoff_end() {
    echo -e "${BLUE}=== Handoff End ===${NC}"
    echo ""

    if [ ! -d "$HANDOFF_DIR" ]; then
        echo -e "${YELLOW}No handoff directory found.${NC}"
        exit 1
    fi

    # Archive
    mkdir -p "$HANDOFF_DIR/sessions"
    TIMESTAMP=$(date +%Y-%m-%d-%H%M)

    if [ -f "$HANDOFF_DIR/HANDOFF.md" ]; then
        cp "$HANDOFF_DIR/HANDOFF.md" "$HANDOFF_DIR/sessions/$TIMESTAMP.md"
        echo -e "${GREEN}✓${NC} Archived to sessions/$TIMESTAMP.md"
    fi

    echo ""
    echo -e "${BLUE}Current State:${NC}"
    git branch --show-current
    git status --short
    echo ""

    echo -e "${BLUE}Recent Commits:${NC}"
    git log -5 --format='%h %s'
    echo ""

    echo -e "${YELLOW}Now update $HANDOFF_DIR/HANDOFF.md with:${NC}"
    echo "  - What was DONE this session"
    echo "  - What FAILED (with details)"
    echo "  - DECISIONS made"
    echo "  - FILES touched"
    echo "  - RESUME point for next session"
}

# Parse arguments
CLAUDE_ARGS=()
RESUME_NAME=""
PROMPT=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --help|-h)
            show_help
            exit 0
            ;;
        --init)
            init_handoff
            exit 0
            ;;
        --start)
            run_handoff_start
            exit 0
            ;;
        --end)
            run_handoff_end
            exit 0
            ;;
        --status)
            show_status
            exit 0
            ;;
        --dir)
            HANDOFF_DIR="$2"
            shift 2
            ;;
        --resume|-r)
            if [[ -n "$2" && ! "$2" =~ ^- ]]; then
                RESUME_NAME="$2"
                shift 2
            else
                RESUME_NAME=""
                shift
            fi
            ;;
        *)
            # Collect remaining args for claude
            if [[ -z "$PROMPT" && ! "$1" =~ ^- ]]; then
                PROMPT="$1"
            else
                CLAUDE_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

# Build claude command
CLAUDE_CMD="claude"

# Add resume if specified
if [[ -n "$RESUME_NAME" ]]; then
    CLAUDE_CMD="$CLAUDE_CMD --resume \"$RESUME_NAME\""
elif [[ ${#CLAUDE_ARGS[@]} -eq 0 && -z "$PROMPT" ]]; then
    # Default: continue last session if no args
    CLAUDE_CMD="$CLAUDE_CMD --continue"
fi

# Add handoff start instruction
HANDOFF_INSTRUCTION="First, run /handoff start to gather context from the previous session."

if [[ -n "$PROMPT" ]]; then
    FULL_PROMPT="$HANDOFF_INSTRUCTION Then: $PROMPT"
    CLAUDE_CMD="$CLAUDE_CMD \"$FULL_PROMPT\""
else
    CLAUDE_CMD="$CLAUDE_CMD \"$HANDOFF_INSTRUCTION\""
fi

# Add any additional claude args
for arg in "${CLAUDE_ARGS[@]}"; do
    CLAUDE_CMD="$CLAUDE_CMD $arg"
done

# Show what we're running
echo -e "${BLUE}Running:${NC} $CLAUDE_CMD"
echo ""

# Execute
eval $CLAUDE_CMD
